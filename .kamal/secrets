# Fetch deployment secrets from 1Password. This file is safe to commit: it contains
# references only, never raw secret values.
SECRETS=$(kamal secrets fetch --adapter 1password --account instaleap-llc.1password.com --from SERVER/TAMAGYM KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE GOOGLE_API_KEY)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
GOOGLE_API_KEY=$(kamal secrets extract GOOGLE_API_KEY $SECRETS)
